# Local Docker (see docker-compose.yml):
# DATABASE_URL=postgresql://mashuk:mashuk@127.0.0.1:5433/mashuk
# Timeweb:
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/default_db
DATABASE_URL=postgresql://USER:PASSWORD@127.0.0.1:5432/default_db
UPLOAD_DIR=./uploads
MAX_FILE_MB=20
CORS_ORIGINS=http://127.0.0.1:8000,http://localhost:8000
FRAME_ANCESTORS=http://127.0.0.1:8000 http://localhost:8000 https://*.tilda.ws https://*.tilda.cc https://mashuk.online https://www.mashuk.online
ADMIN_PASSWORD=change-me
ADMIN_SECRET=change-this-secret
