[Unit]
Description=Mashuk seminar application API
After=network.target

[Service]
User=www-data
Group=www-data
WorkingDirectory=/var/www/mashuk_forms
EnvironmentFile=/var/www/mashuk_forms/.env
ExecStart=/var/www/mashuk_forms/.venv/bin/gunicorn -w 2 -k uvicorn.workers.UvicornWorker -b 127.0.0.1:8000 app:app
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
